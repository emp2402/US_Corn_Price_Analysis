    create or replace table `us-corn-data`.`us_corn_data_transformed`.`stg_corn_climate_features`
      
    
    

    
    OPTIONS()
    as (
      with climate_source as (
    select * from `us-corn-data`.`us_corn_data`.`us_climate_data`
),

planting_source as (
    select * from `us-corn-data`.`us_corn_data_transformed`.`stg_corn_plantings`
),

daily_metrics as (
    select
        CAST(c.year as INT64) as year,
        c.date as weather_date,
        -- Calculate Day of Year (1-365) for every weather row
        EXTRACT(DAYOFYEAR FROM c.date) as weather_doy,
        
        -- Ensure metrics are numeric floats
        CAST(c.Precipitation as FLOAT64) as prcp,
        CAST(c.Max_Temp as FLOAT64) as tmax,
        
        -- Bring in the Planting 50% DOY for this specific year
        p.planting_50_pct_doy

    from climate_source c
    -- Inner Join: We can only calculate these features if we have planting data for that year
    inner join planting_source p on CAST(c.year as INT64) = p.year
),

aggregated_features as (
    select
        year,
        planting_50_pct_doy,

        -- FEATURE 1: Rainfall Effectiveness Index
        -- Step A: Calculate Rain during Soil Prep (March 1 to June 30 -> DOY 60 to 181)
        SUM(CASE 
            WHEN weather_doy BETWEEN 60 AND 181 THEN prcp 
            ELSE 0 
        END) as soil_prep_rain_cumulative,

        -- FEATURE 2: Temp Stress (July/Pollination)
        -- Window: 60 to 90 days after planting
        -- We count HOW MANY days exceeded 35°C (95°F)
        COUNT(CASE 
            WHEN weather_doy BETWEEN (planting_50_pct_doy + 60) AND (planting_50_pct_doy + 90)
            AND tmax > 35 
            THEN 1 
            ELSE NULL 
        END) as heat_stress_days_count,

        -- FEATURE 3: Post-Pollination Rain (Grain Filling)
        -- Window: Same window (60 to 90 days after planting)
        SUM(CASE 
            WHEN weather_doy BETWEEN (planting_50_pct_doy + 60) AND (planting_50_pct_doy + 90)
            THEN prcp 
            ELSE 0 
        END) as post_pollination_rain_cumulative

    from daily_metrics
    group by year, planting_50_pct_doy
)

select
    year,
    
    planting_50_pct_doy,
    
    -- Final Calc for Feature 1: The Effectiveness Index
    -- (Total Prep Rain / Days needed to reach 50% planted)
    -- Higher Score = Good Rain + Early Planting
    -- Lower Score = Low Rain OR Late Planting (Wasted Rain)
    SAFE_DIVIDE(soil_prep_rain_cumulative, planting_50_pct_doy) as rainfall_effectiveness_index,
    
    -- Pass through the other features
    heat_stress_days_count as temp_stress_july_count,
    post_pollination_rain_cumulative as post_pollination_rain

from aggregated_features
order by year desc
    );
  
