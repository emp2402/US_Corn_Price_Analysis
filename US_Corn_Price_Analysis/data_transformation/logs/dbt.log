        -- Formula: (Ending Stocks / Total Usage)
        -- Use SAFE_DIVIDE to prevent errors if Usage is ever 0
        SAFE_DIVIDE(ending_stocks, total_usage) as stock_to_use_ratio

    from cleaned
)

select * from calculated
order by year desc
    );
  
