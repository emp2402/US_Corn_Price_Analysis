[0m11:57:58.867044 [debug] [Thread-1 (]: On model.corn_market_project.mart_corn_model_data: /* {"app": "dbt", "dbt_version": "1.11.2", "profile_name": "corn_market_project", "target_name": "dev", "node_id": "model.corn_market_project.mart_corn_model_data"} */

  
    

    create or replace table `us-corn-data`.`us_corn_data_transformed`.`mart_corn_model_data`
      
    
    

    
    OPTIONS()
    as (
      with prices as (
    select * from `us-corn-data`.`us_corn_data_transformed`.`stg_corn_prices`
),

supply as (
    select * from `us-corn-data`.`us_corn_data_transformed`.`stg_corn_supply_demand`
),

conditions as (
    select * from `us-corn-data`.`us_corn_data_transformed`.`stg_corn_conditions`
),

climate as (
    select * from `us-corn-data`.`us_corn_data_transformed`.`stg_corn_climate_features`
),

final_join as (
    select
        -- The "Key" (Year)
        p.year,
        
        -- TARGET VARIABLE (What we want to predict)
        p.price_per_bushel,
        
        -- FEATURES (The predictors)
        -- 1. Supply & Demand Metrics
        s.stock_to_use_ratio,
        s.ending_stocks,
        s.total_supply,
        
        -- 2. Crop Health Metrics (July Pollination Window)
        c.avg_condition_pollination_index,
        
        -- 3. Bio-Meteorological Metrics
        cl.planting_50_pct_doy,
        cl.rainfall_effectiveness_index,
        cl.temp_stress_july_count,
        cl.post_pollination_rain

    from prices p
    
    -- Left Join: We want to keep Price data even if a feature is missing (rare, but safer)
    left join supply s on p.year = s.year
    left join conditions c on p.year = c.year
    left join climate cl on p.year = cl.year
)

select * from final_join
-- Final filter: Drop 2025/future years where we might have partial data but no price yet
where price_per_bushel IS NOT NULL
order by year desc
    );
  
